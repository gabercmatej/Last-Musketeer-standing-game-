<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="menu" class="screen menu-screen">
        <ui:VisualElement name="menu-bg" class="fill-bg" picking-mode="Ignore" />
        <ui:VisualElement class="menu-shade" picking-mode="Ignore" />
        <ui:VisualElement class="menu-layout" picking-mode="Ignore">
            <ui:VisualElement class="menu-left" picking-mode="Ignore">
                <ui:VisualElement name="menu-logo" class="menu-logo" picking-mode="Ignore" />
                <ui:Label name="menu-title" text="The Last Musketeer Standing" class="title title--hero" />
            </ui:VisualElement>
            <ui:VisualElement class="panel menu-panel">
                <ui:Label text="Your name" class="section-label" />
                <ui:TextField name="name-field" max-length="16" class="field" />
                <ui:Button name="play-bots" text="Play vs Bots" class="btn btn--big" />
                <ui:VisualElement class="menu-row">
                    <ui:Button name="host" text="Host" class="btn btn--half" />
                    <ui:Button name="join" text="Join" class="btn btn--half" />
                </ui:VisualElement>
                <ui:Label text="Online play is coming tomorrow." class="note" />
                <ui:VisualElement class="menu-row">
                    <ui:Button name="settings" text="Settings" class="btn btn--half btn--quiet" />
                    <ui:Button name="fullscreen" text="Fullscreen" class="btn btn--half btn--quiet" />
                </ui:VisualElement>
                <ui:VisualElement name="dev-row" class="menu-row dev-row">
                    <ui:Label text="DEV" class="badge badge--dev" />
                    <ui:Label text="Seed" class="dev-label" />
                    <ui:TextField name="seed-field" max-length="10" class="field field--seed" />
                    <ui:Label text="blank = random, F2 = plan every unit" class="dev-label" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label text="Plan in secret. Everything resolves at once. Be the last one standing." class="tagline" picking-mode="Ignore" />
        <ui:Label name="menu-version" text="" class="corner-note" />
    </ui:VisualElement>
</ui:UXML>
