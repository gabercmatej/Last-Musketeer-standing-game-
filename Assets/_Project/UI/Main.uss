/* The Last Musketeer Standing: one stylesheet for every screen, laid out for a 1280x720 reference panel
   (PanelSettings scales it). Skin: Matej's royal-blue panels with gold trim (9-sliced), Pirata One titles,
   Fredoka UI text. Images that a screen needs at runtime (logo, portraits, icons) are set from code with
   placeholder fallbacks; panels and buttons fall back to their background colours if the art is missing. */

:root {
    --ink: rgb(252, 244, 222);
    --ink-dim: rgb(206, 196, 172);
    --ink-faint: rgb(150, 142, 128);
    --gold: rgb(255, 206, 96);
    --gold-dark: rgb(170, 118, 34);
    --navy: rgb(14, 30, 92);
    --navy-deep: rgba(8, 14, 44, 0.92);
    --line: rgba(255, 214, 120, 0.35);
    --danger: rgb(255, 98, 86);
    --good: rgb(120, 230, 150);
    --dev: rgb(120, 220, 255);
    color: var(--ink);
    font-size: 15px;
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/Fredoka-SemiBold.ttf");
}

.screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.screen--dim {
    background-color: rgba(6, 8, 20, 0.62);
    align-items: center;
    justify-content: center;
}

.screen--modal {
    background-color: rgba(4, 6, 16, 0.7);
    align-items: center;
    justify-content: center;
}

.fill-bg {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgb(20, 18, 28);
}

/* ---------- skin: panels, buttons, titles ---------- */

.panel {
    background-image: url("/Assets/_Project/Art/UI/panels/panel.png");
    -unity-slice-left: 80;
    -unity-slice-right: 80;
    -unity-slice-top: 80;
    -unity-slice-bottom: 80;
    -unity-slice-scale: 0.42px;
    background-color: rgba(0, 0, 0, 0);
    padding: 26px 30px;
}

.panel--slim {
    -unity-slice-scale: 0.28px;
    padding: 8px 18px;
}

.panel-bar {
    background-color: var(--navy-deep);
    border-color: var(--gold-dark);
}

.title {
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/PirataOne-Regular.ttf");
    font-size: 40px;
    color: var(--gold);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(40, 22, 6);
    text-shadow: 2px 3px 2px rgba(0, 0, 0, 0.6);
    margin-bottom: 4px;
}

.title--hero {
    font-size: 62px;
    white-space: normal;
}

.title--panel {
    font-size: 34px;
}

.subtitle {
    color: var(--ink-dim);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 10px;
}

.section-label {
    font-size: 12px;
    color: var(--gold);
    letter-spacing: 1px;
    margin: 8px 0 4px 2px;
}

.section-label--inline {
    margin: 0 8px 0 0;
}

.note {
    font-size: 12px;
    color: var(--ink-faint);
    -unity-text-align: middle-center;
    margin: 2px 0 6px 0;
}

.corner-note {
    position: absolute;
    right: 12px;
    bottom: 8px;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.55);
}

.btn {
    background-image: url("/Assets/_Project/Art/UI/panels/button.png");
    -unity-slice-left: 54;
    -unity-slice-right: 54;
    -unity-slice-top: 30;
    -unity-slice-bottom: 30;
    -unity-slice-scale: 0.42px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--ink);
    font-size: 16px;
    padding: 8px 22px;
    margin: 4px;
    min-height: 40px;
    -unity-text-outline-width: 0.5px;
    -unity-text-outline-color: rgb(6, 12, 40);
    transition-property: scale, opacity;
    transition-duration: 0.08s;
}

.btn:hover {
    scale: 1.03 1.03;
}

.btn:active {
    background-image: url("/Assets/_Project/Art/UI/panels/button_pressed.png");
    scale: 0.98 0.98;
}

.btn:disabled {
    opacity: 0.45;
    scale: 1 1;
}

.btn--big {
    font-size: 22px;
    min-height: 54px;
    margin-top: 10px;
    -unity-slice-scale: 0.55px;
}

.btn--small {
    font-size: 12px;
    min-height: 30px;
    padding: 4px 14px;
    -unity-slice-scale: 0.3px;
}

.btn--icon {
    font-size: 18px;
    min-height: 34px;
    width: 46px;
    padding: 2px;
    -unity-slice-scale: 0.3px;
}

.btn--half {
    flex-grow: 1;
    flex-basis: 0;
}

.btn--quiet {
    opacity: 0.85;
    font-size: 14px;
}

.btn--primary {
    -unity-font-style: bold;
}

.btn--start {
    width: 210px;
    font-size: 26px;
    min-height: 66px;
    -unity-background-image-tint-color: rgb(255, 236, 180);
}

.field {
    margin: 0;
    font-size: 17px;
}

.field > .unity-text-field__input,
.field .unity-base-text-field__input {
    background-color: rgba(4, 8, 28, 0.85);
    border-color: var(--gold-dark);
    border-width: 1px;
    color: var(--ink);
    padding: 7px 10px;
    border-radius: 6px;
}

.badge {
    font-size: 11px;
    padding: 2px 6px;
    border-radius: 4px;
}

.badge--dev {
    color: rgb(10, 30, 40);
    background-color: var(--dev);
}

.menu-row {
    flex-direction: row;
    align-items: center;
}

.menu-row--center {
    justify-content: center;
}

.dev-row {
    margin-top: 8px;
    flex-wrap: wrap;
}

.dev-hint {
    width: 100%;
    margin: 2px 4px 0 4px;
    white-space: normal;
}

.dev-label {
    color: var(--dev);
    font-size: 11px;
    margin: 0 4px;
}

.field--seed {
    width: 90px;
}

/* ---------- main menu ---------- */

.menu-shade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.18);
}

.menu-layout {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    padding: 70px 48px 30px 40px;
}

.menu-title {
    font-size: 40px;
    white-space: normal;
    margin-bottom: 10px;
}

.menu-play {
    width: auto;
    margin: 12px 0 8px 0;
    min-height: 78px;
    font-size: 32px;
}

.name-hint {
    color: rgb(255, 120, 96);
    font-size: 14px;
    margin: 4px 0 0 2px;
    min-height: 18px;
    white-space: normal;
}

.field--error > .unity-text-field__input,
.field--error .unity-base-text-field__input {
    border-color: rgb(255, 98, 86);
    border-width: 2px;
}

.corner-row {
    position: absolute;
    right: 40px;   /* the Fullscreen icon's right edge lines up with the menu panel's right edge (48px padding minus the icon's inset) */
    top: 16px;
    flex-direction: row;
    align-items: flex-start;
}

/* Lobby, HUD and results: the same icon trio in the top-left corner. */
.corner-row--left {
    left: 6px;   /* the first icon has a 14px left margin */
    right: auto;
}

.icon-btn {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
    margin: 0 0 0 14px;
    width: 76px;
    align-items: center;
    transition-property: scale;
    transition-duration: 0.1s;
}

.icon-btn:hover {
    scale: 1.06 1.06;
}

.icon-btn:active {
    scale: 0.96 0.96;
}

.icon-btn__img {
    width: 58px;
    height: 58px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(222, 222, 222);
    align-items: center;
    justify-content: center;
}

.icon-btn:hover > .icon-btn__img {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.icon-btn__img--fallback {
    background-color: var(--navy);
    border-color: var(--gold-dark);
    border-width: 2px;
    border-radius: 8px;
}

.icon-btn__initial {
    font-size: 26px;
    color: var(--gold);
}

.icon-btn__caption {
    font-size: 13px;
    color: rgb(255, 243, 214);
    margin-top: 2px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(10, 6, 4, 0.8);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
    white-space: nowrap;
}

/* Every name label: one line, "..." when it does not fit. Needs a constrained width (max-width or flex-shrink). */
.name-clip {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
}

.menu-panel {
    width: 360px;
    padding: 20px 24px;
}

/* ---------- lobby ---------- */

.gm-panel {
    position: absolute;
    right: 14px;
    top: 12px;
    width: 340px;
    padding: 16px 20px 14px 20px;
    -unity-slice-scale: 0.36px;
}

.gm-header {
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/PirataOne-Regular.ttf");
    font-size: 26px;
    color: var(--gold);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(40, 22, 6);
    margin-bottom: 6px;
}

/* One line = a label column and a control column, every line the same height. */
.gm-line {
    flex-direction: row;
    align-items: center;
    height: 38px;
}

.gm-label {
    width: 110px;
    flex-shrink: 0;
    font-size: 15px;
    color: var(--ink-dim);
}

.gm-control {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-basis: 0;
}

.gm-step {
    width: 38px;
    min-height: 32px;
    font-size: 18px;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
}

.gm-value {
    flex-grow: 1;
    flex-basis: 0;
    font-size: 20px;
    color: var(--gold);
    -unity-text-align: middle-center;
}

/* 4F §8: "3" and the heart touch, centred as one unit between the - and + buttons. */
.gm-value--tight {
    flex-grow: 0;
    flex-basis: auto;
    min-width: 0;
    margin: 0;
    padding: 0;
}

.gm-value-box {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.gm-heart {
    width: 20px;
    height: 20px;
    margin: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* 4F §7: the map row gets a short label and a fixed, wider selector so "The Courtyard" fits whole and the
   arrows don't move when the name changes to "The Bridge". */
.gm-label--map {
    width: 44px;
}

.gm-control--map {
    flex-grow: 0;
    flex-basis: auto;
    width: 256px;
    margin-left: auto;
}

.map-name {
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    min-width: 0;
    font-size: 16px;
    color: var(--gold);
    -unity-text-align: middle-center;
}

.map-desc {
    font-size: 12px;
    color: var(--ink-dim);
    white-space: normal;
    -unity-text-align: upper-center;
    margin: 0 4px 4px 4px;
    min-height: 30px;
}

.gm-default {
    align-self: center;
    width: 130px;
    margin: 8px 0 0 0;
}

.gm-panel--readonly .gm-step,
.gm-panel--readonly .gm-default {
    display: none;
}

.lobby-bl {
    position: absolute;
    left: 24px;
    bottom: 10px;
    flex-direction: row;
    align-items: flex-end;
}

.lobby-bl .icon-btn {
    margin: 0 18px 0 0;
}

.lobby-br {
    position: absolute;
    right: 28px;
    bottom: 22px;
    align-items: flex-end;
}

.lobby-br .btn--start {
    width: 240px;
    min-height: 72px;
    font-size: 30px;
    margin: 0;
}

.btn--start.btn--secondary {
    -unity-background-image-tint-color: rgb(185, 195, 225);
    opacity: 0.9;
}

.icon-btn--big {
    width: 104px;
}

.icon-btn--big > .icon-btn__img {
    width: 76px;
    height: 76px;
}

.icon-btn--big > .icon-btn__caption {
    font-size: 15px;
}

.confirm-panel {
    width: 600px;
    padding: 30px 36px 24px 36px;
    align-items: stretch;
}

.confirm-message {
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/PirataOne-Regular.ttf");
    font-size: 34px;
    color: var(--gold);
    -unity-text-align: middle-center;
    white-space: normal;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(40, 22, 6);
    margin-bottom: 14px;
}

.confirm-row {
    flex-direction: row;
    justify-content: center;
}

.confirm-btn {
    flex-grow: 1;
    flex-basis: 0;
    margin: 4px 8px;
    font-size: 22px;
}

.wardrobe {
    position: absolute;
    right: 24px;
    top: 118px;
    bottom: 24px;
    width: 470px;
    padding: 28px 34px 20px 34px;
    display: none;
}

.wardrobe .info-tab {
    font-size: 18px;
    min-height: 42px;
}

.wardrobe .info-close {
    width: 150px;
    min-height: 46px;
    font-size: 20px;
    margin-left: 8px;
}

.wardrobe-buttons {
    align-items: center;
}

.wardrobe .wardrobe-side {
    width: 112px;
    min-height: 40px;
    font-size: 15px;
    margin: 0 8px;
}

/* 4F §10: the Boots tab opens (a sneak peek), so it is only dimmed a little. */
.info-tab--soon {
    opacity: 0.75;
}

.tab-soon-name {
    font-size: 16px;
    color: var(--ink);
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.tab-soon-note {
    font-size: 10px;
    color: var(--ink-dim);
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.wardrobe .title--panel {
    margin-bottom: 6px;
}

.wardrobe-grid {
    flex-grow: 1;
}

#wardrobe-grid .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.item {
    width: 82px;
    height: 82px;
    margin: 4px;
    border-radius: 10px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.1);
    background-color: rgba(0, 0, 0, 0.3);
    align-items: center;
    justify-content: center;
}

.item:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

.item--on {
    border-color: var(--gold);
    background-color: rgba(255, 206, 96, 0.18);
}

.item-icon {
    width: 70px;
    height: 70px;
    -unity-background-scale-mode: scale-to-fit;
}

/* 4F §10: boots preview: greyed out, "Coming soon" across the bottom, not equippable. */
.item--soon .item-icon {
    opacity: 0.4;
}

.item--soon:hover {
    scale: 1 1;
}

.item-soon {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4px;
    font-size: 10px;
    color: var(--ink);
    background-color: rgba(20, 14, 10, 0.75);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 1px 0;
}

.item-none {
    font-size: 13px;
    color: var(--ink-dim);
}

.item-name {
    font-size: 16px;
    color: var(--gold);
    -unity-text-align: middle-center;
    margin: 6px 0 2px 0;
}

/* ---------- loading ---------- */

.loading-shade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.25);
}

.loading-panel {
    position: absolute;
    left: 290px;
    right: 290px;
    bottom: 40px;
    align-items: stretch;
}

.loading-tip {
    font-size: 17px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin: 6px 0 14px 0;
    min-height: 44px;
}

.bar {
    height: 14px;
    border-radius: 7px;
    background-color: rgba(0, 0, 0, 0.5);
    border-color: var(--gold-dark);
    border-width: 1px;
    overflow: hidden;
}

.bar-fill {
    height: 100%;
    width: 0%;
    background-color: var(--gold);
    border-radius: 7px;
}

/* ---------- info window: Lore / How to play / Settings ---------- */

.info-window {
    width: 780px;
    height: 600px;
    padding: 28px 40px 22px 40px;
}

.info-tabs {
    flex-direction: row;
    margin-bottom: 8px;
}

.info-tab {
    width: auto;
    flex-grow: 1;
    flex-basis: 0;
    font-size: 22px;
    min-height: 50px;
    margin: 0 3px;
    opacity: 0.6;
}

.info-tab--on {
    opacity: 1;
}

.info-page {
    padding-top: 8px;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.info-scroll {
    flex-grow: 1;
}

.info-title {
    font-size: 40px;
    margin-bottom: 8px;
}

.info-text {
    font-size: 16px;
    color: var(--ink);
    white-space: normal;
    padding: 0 8px 8px 8px;
}

.info-scroll .unity-scroller__low-button,
.info-scroll .unity-scroller__high-button {
    display: none;
}

.info-scroll .unity-base-slider--vertical,
.info-scroll .unity-scroller--vertical {
    width: 12px;
}

.info-scroll .unity-base-slider__tracker {
    background-color: rgba(4, 8, 28, 0.6);
    border-width: 0;
    border-radius: 6px;
}

.info-scroll .unity-base-slider__dragger {
    background-color: var(--gold-dark);
    border-width: 0;
    border-radius: 6px;
    width: 12px;
}

.info-close {
    align-self: center;
    width: 160px;
    min-height: 52px;
    font-size: 22px;
    margin-top: 6px;
}

.howto-table {
    margin: 6px 8px 8px 8px;
}

.howto-row {
    flex-direction: row;
    align-items: center;
    padding: 1px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
}

.howto-icon {
    width: 30px;
    height: 30px;
    margin-right: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

.howto-name {
    width: 120px;
    font-size: 16px;
    color: var(--gold);
}

.howto-cost {
    width: 110px;
    font-size: 13px;
    color: var(--ink-dim);
}

.howto-desc {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 14px;
    white-space: normal;
}

.volume {
    margin: 8px 0;
}

.volume > .unity-label {
    color: var(--ink);
    min-width: 150px;
    font-size: 16px;
}

.credits-scroll {
    flex-grow: 1;
    margin-bottom: 4px;
}

.credits {
    font-size: 11px;
    color: var(--ink-dim);
    white-space: normal;
}

/* ---------- character select ---------- */

.charselect-shade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(4, 6, 16, 0.9);
}

.charselect-bg {
    display: none;
}

.charselect-title {
    align-self: stretch;
    font-size: 54px;
    margin-bottom: 8px;
}

.charselect-body {
    position: absolute;
    left: 40px;
    right: 40px;
    top: 0;
    bottom: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.cs-main {
    width: 720px;
    flex-shrink: 1;
    margin-left: 24px;
    align-items: stretch;
}

.cs-picker {
    width: 150px;
    justify-content: center;
    align-items: center;
}

.cs-pick-holder {
    width: 112px;
    height: 112px;
    margin: 7px 0;
    align-items: center;
    justify-content: center;
}

.cs-pick-glow {
    position: absolute;
    left: -10px;
    right: -10px;
    top: -10px;
    bottom: -10px;
    border-radius: 66px;
    display: none;
}

.cs-pick {
    width: 96px;
    height: 96px;
    border-radius: 48px;
    border-width: 4px;
    background-color: rgba(0, 0, 0, 0.35);
    -unity-background-scale-mode: scale-and-crop;
    transition-property: scale;
    transition-duration: 0.1s;
    opacity: 0.85;
}

.cs-pick:hover {
    scale: 1.05 1.05;
    opacity: 1;
}

.cs-pick--on {
    scale: 1.14 1.14;
    border-width: 6px;
    opacity: 1;
}

.cs-ribbon {
    position: absolute;
    bottom: 6px;
    background-color: rgb(190, 50, 44);
    color: var(--ink);
    font-size: 11px;
    padding: 1px 8px;
    border-radius: 4px;
    display: none;
}

.cs-bio {
    padding: 22px 34px;
}

.cs-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.cs-portrait {
    width: 132px;
    height: 132px;
    border-radius: 66px;
    border-width: 5px;
    background-color: rgba(0, 0, 0, 0.35);
    -unity-background-scale-mode: scale-and-crop;
    margin-right: 20px;
    flex-shrink: 0;
}

.cs-headtext {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.cs-name {
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/PirataOne-Regular.ttf");
    font-size: 50px;
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(20, 10, 4);
}

.cs-title {
    font-size: 19px;
    color: var(--ink-dim);
    margin-bottom: 6px;
}

.cs-stat {
    flex-direction: row;
    align-items: baseline;
}

.cs-stat-label {
    width: 96px;
    font-size: 14px;
    color: var(--gold);
}

.cs-stat-value {
    flex-shrink: 1;
    min-width: 0;
    font-size: 17px;
    color: var(--ink);
}

.cs-story {
    font-size: 16px;
    color: var(--ink);
    white-space: normal;
    margin: 6px 0 12px 0;
}

.cs-sig {
    flex-direction: row;
    align-items: center;
    background-color: rgba(4, 8, 28, 0.55);
    border-color: var(--gold-dark);
    border-width: 1px;
    border-radius: 8px;
    padding: 10px 14px;
}

.cs-sig-icon {
    width: 54px;
    height: 54px;
    margin-right: 14px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.cs-sig-text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.cs-sig-head {
    flex-direction: row;
    align-items: baseline;
}

.cs-sig-name {
    font-size: 22px;
    color: var(--gold);
    margin-right: 12px;
    flex-shrink: 0;
    white-space: nowrap;
}

.cs-sig-cost {
    font-size: 14px;
    color: var(--ink-dim);
    flex-shrink: 0;
    white-space: nowrap;
}

.cs-sig-desc {
    font-size: 14px;
    color: var(--ink);
    white-space: normal;
}

.charselect-buttons {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 6px;
}

/* Back and Select: identical box model, so they share one baseline, centred under the character box. */
.charselect-buttons .btn {
    min-height: 66px;
    font-size: 26px;
    margin: 10px 10px 0 10px;
}

.charselect-buttons .cs-back {
    width: 200px;
}

.charselect-buttons .cs-select {
    width: 300px;
}

/* ---------- HUD ----------
   The HUD sits around the arena, never on it. HudUI positions the four regions (top strip, bottom bar, left and
   right columns) from the arena rect the camera reports (HudLayout); the rules here style what is inside them.
   .hud--compact (narrow side margins) shrinks text; .hud--overlap means a column reaches onto the board edge,
   so the panels are semi-transparent. */

.top-strip {
    position: absolute;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.top-left {
    position: absolute;
    top: 6px;
}

.round-label {
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/PirataOne-Regular.ttf");
    font-size: 26px;
    color: var(--gold);
    -unity-text-outline-width: 1.2px;
    -unity-text-outline-color: rgb(30, 16, 4);
    margin: 0;
    padding: 0;
}

.turn-label {
    color: var(--ink);
    font-size: 13px;
    margin: 0;
    padding: 0;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(20, 12, 4);
}

.top-center {
    align-items: center;
    padding: 2px 22px;
    border-radius: 14px;
    background-color: rgba(8, 14, 44, 0.9);
}

.timer {
    font-size: 30px;
    -unity-text-align: middle-center;
    color: var(--ink);
    margin: 0;
    padding: 0;
}

.timer--low {
    color: var(--danger);
}

.phase-label {
    font-size: 11px;
    color: var(--ink-dim);
    margin: 0;
    padding: 0;
}

.side-col {
    position: absolute;
}

.left-col {
    align-items: stretch;
}

.right-col {
    align-items: stretch;
}

.scores {
    flex-direction: column;
    align-items: stretch;
    align-self: flex-end;
    width: 100%;
    max-width: 172px;
}

.score {
    flex-direction: row;
    align-items: center;
    height: 38px;
    padding: 2px 8px 2px 2px;
    margin-bottom: 4px;
    border-radius: 22px;
    background-color: rgba(8, 14, 44, 0.92);
    border-width: 2px;
    overflow: hidden;
}

/* Out this round: dimmed, but clearly readable (FIXES_4E §4.3). */
.score--dead {
    opacity: 0.7;
}

/* Match point (FIXES_4E §8.7): points >= points to win. Gold border and a soft glow behind the box. */
.score--match {
    border-color: rgb(255, 206, 96);
    background-color: rgba(60, 44, 10, 0.95);
}

.score-name--match {
    color: rgb(255, 224, 140);
    -unity-font-style: bold;
}

.score-pop {
    position: absolute;
    right: 6px;
    top: 4px;
    font-size: 22px;
    color: rgb(255, 230, 120);
    -unity-font-style: bold;
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(30, 16, 4);
    opacity: 0;
}

.score-portrait {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    border-radius: 14px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-and-crop;
}

.score-name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: 13px;
    margin: 0 4px 0 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.score-points {
    flex-shrink: 0;
    font-size: 18px;
    color: var(--gold);
    margin: 0;
    padding: 0;
}

.score-icon {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-left: 3px;
    -unity-background-scale-mode: scale-to-fit;
}

.hud-icons {
    flex-direction: row;
    margin-bottom: 4px;
    margin-left: -2px;
}

.hud-icons .icon-btn {
    width: 52px;
    margin: 0 3px 0 0;
}

.hud-icons .icon-btn__img {
    width: 42px;
    height: 42px;
}

.hud-icons .icon-btn__caption {
    font-size: 11px;
    margin-top: 0;
}

.hud--compact .hud-icons .icon-btn { width: 40px; margin-right: 3px; }
.hud--compact .hud-icons .icon-btn__img { width: 36px; height: 36px; }
.hud--compact .hud-icons .icon-btn__caption { display: none; }

/* Chat: a short fading log, a text field and the four emote buttons (top of the left column). */
.chat {
    margin-top: 6px;
    align-self: flex-end;
    width: 100%;
    max-width: 172px;
}

.chat-log {
    margin-bottom: 2px;
    max-height: 110px;
    overflow: hidden;
    justify-content: flex-end;
}

.chat-line {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 1px;
    padding: 1px 4px;
    border-radius: 4px;
    background-color: rgba(8, 14, 44, 0.9);
}

.chat-name {
    flex-shrink: 1;
    min-width: 0;
    max-width: 62px;
    font-size: 11px;
    margin: 0 3px 0 0;
    padding: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-outline-width: 0.8px;
    -unity-text-outline-color: rgb(20, 12, 4);
}

.chat-text {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    max-height: 28px;
    font-size: 11px;
    margin: 0;
    padding: 0;
    white-space: normal;
    overflow: hidden;
    color: var(--ink);
    -unity-text-align: upper-left;
}

.chat-text--emote {
    -unity-font-style: italic;
    color: var(--ink-dim);
}

.chat-field {
    margin: 0 0 3px 0;
    height: 24px;
}

.chat-field > .unity-base-text-field__input {
    font-size: 12px;
    padding: 1px 4px;
    min-height: 22px;
    background-color: rgba(8, 14, 44, 0.94);
    color: var(--ink);
    border-color: var(--line);
}

.chat-emotes {
    flex-direction: row;
    justify-content: space-between;
}

.chat-emote {
    width: 30px;
    height: 30px;
    margin: 0;
    padding: 0;
    border-radius: 15px;
    border-width: 1px;
    border-color: var(--gold-dark);
    background-color: rgba(8, 14, 44, 0.92);
    align-items: center;
    justify-content: center;
}

.chat-emote:hover {
    background-color: rgba(40, 64, 150, 0.9);
}

.chat-emote__img {
    width: 22px;
    height: 22px;
    -unity-background-scale-mode: scale-to-fit;
    align-items: center;
    justify-content: center;
}

.chat-emote__initial {
    font-size: 13px;
    color: var(--gold);
}

.hud--compact .chat-log { max-height: 58px; }
.hud--compact .chat-name { max-width: 48px; font-size: 10px; }
.hud--compact .chat-text { font-size: 10px; max-height: 26px; }
.hud--compact .chat-emote { width: 26px; height: 26px; border-radius: 13px; }
.hud--compact .chat-emote__img { width: 19px; height: 19px; }

.corner-buttons {
    flex-direction: row;
    margin-bottom: 4px;
}

.btn--hud {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 28px;
    margin: 0 2px 0 0;
    padding: 3px 6px;
    font-size: 12px;
}

.dev-badge {
    font-size: 10px;
    white-space: normal;
    margin-bottom: 6px;
}


.log-panel {
    position: absolute;
    right: 10px;
    top: 270px;
    bottom: 92px;
    width: 300px;
    background-color: var(--navy-deep);
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--line);
    padding: 8px;
}

.log-title {
    color: var(--gold);
    margin-bottom: 4px;
}

.log-scroll {
    flex-grow: 1;
}

.log-line {
    font-size: 12px;
    white-space: normal;
    color: var(--ink-dim);
}

.log-line--tick {
    color: var(--ink);
    margin-top: 4px;
}

.log-line--turn {
    color: var(--gold);
    margin-top: 8px;
}

.log-line--big {
    color: var(--ink);
}

.plan-panel {
    padding: 6px;
    border-radius: 10px;
    background-color: rgba(8, 14, 44, 0.92);
    border-width: 1px;
    border-color: var(--line);
}

.planning-for {
    font-size: 15px;
    -unity-text-align: middle-left;
    margin: 0 0 4px 2px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.slots {
    flex-direction: column;
}

.slot {
    height: 44px;
    margin: 0 0 4px 0;
    flex-direction: row;
    align-items: center;
    padding: 2px 6px;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(20, 40, 110, 0.94);
    overflow: hidden;
}

.slot:hover {
    background-color: rgba(40, 64, 150, 0.96);
}

.slot--cursor {
    border-color: var(--gold);
}

.slot--invalid {
    border-color: var(--danger);
    background-color: rgba(110, 30, 30, 0.94);
}

.slot--locked {
    opacity: 0.7;
}

.slot-num {
    font-size: 12px;
    color: var(--ink-faint);
    width: 12px;
    flex-shrink: 0;
}

.slot-icon {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.slot-col {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    overflow: hidden;
}

.slot-text {
    font-size: 13px;
    margin: 0;
    padding: 0;
    min-width: 0;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
    white-space: nowrap;
}

.slot-line {
    flex-direction: row;
    align-items: center;
    min-width: 0;
    overflow: hidden;
}

.slot-dir {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    margin-left: 4px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 230, 170);
}

.slot-sub {
    font-size: 10px;
    color: var(--danger);
    margin: 0;
    padding: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.btn--lock {
    height: 38px;
    margin: 4px 0 0 0;
    font-size: 14px;
    padding: 2px 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.btn--locked {
    -unity-background-image-tint-color: rgb(140, 255, 170);
}

.hint {
    font-size: 11px;
    color: var(--ink);
    margin: 2px 2px 0 2px;
    white-space: normal;
    -unity-text-align: upper-left;
}

/* Bottom bar: the big Grit counter, then the grouped action bar. */
.bottom-bar {
    position: absolute;
    background-color: rgba(8, 14, 44, 0.9);
    flex-direction: row;
    align-items: center;
}

.grit-box {
    flex-shrink: 0;
    height: 64px;
    padding: 2px 10px;
    border-radius: 10px;
    border-width: 2px;
    border-color: var(--gold-dark);
    background-color: rgba(8, 14, 44, 0.95);
    justify-content: center;
}

.grit-title {
    font-size: 10px;
    color: var(--gold);
    margin: 0;
    padding: 0;
    -unity-text-align: upper-left;
}

.grit-row {
    flex-direction: row;
    align-items: center;
}

.grit-num {
    font-size: 42px;
    color: var(--ink);
    margin: -6px 10px 0 0;
    padding: 0;
    min-width: 32px;
    -unity-text-align: middle-center;
}

.grit-pips {
    flex-direction: row;
    flex-wrap: nowrap;
    flex-shrink: 1;
}

.grit-pip {
    flex-shrink: 0;
    width: 15px;
    height: 15px;
    margin: 0 2px;
    border-radius: 8px;
    border-width: 2px;
    border-color: var(--gold-dark);
    background-color: rgba(255, 255, 255, 0.06);
}

.grit-pip--on {
    background-color: var(--gold);
    border-color: rgb(255, 240, 190);
}

.actions {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
}

.special-slot {
    flex-shrink: 0;
}

.action-group {
    flex-shrink: 1;
    min-width: 0;
    margin: 0 6px;
    padding: 0 0 0 8px;
    border-left-width: 1px;
    border-left-color: var(--line);
}

.action-group--0 {
    border-left-width: 0;
    padding-left: 0;
    flex-grow: 3;
}

.action-group--1 {
    flex-grow: 5;
}

.action-group--2 {
    margin: 0;
    padding: 0;
    border-left-width: 0;
}

.action-group-label {
    font-size: 11px;
    color: var(--ink);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(8, 14, 44);
    height: 13px;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
}

.action-row {
    flex-direction: row;
}

.action {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 50px;
    max-width: 130px;
    height: 58px;
    margin: 0 2px;
    padding: 3px 2px 2px 2px;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(255, 214, 120, 0.25);
    background-color: rgba(20, 40, 110, 0.95);
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
    transition-property: background-color, translate, opacity;
    transition-duration: 0.08s;
}

.action:hover {
    background-color: rgba(44, 70, 160, 0.95);
    translate: 0 -2px;
}

.action--pending {
    background-color: var(--gold-dark);
    border-color: var(--gold);
}

/* Unavailable (no Grit, unloaded musket...): ~58% opacity and desaturated, still clearly readable (FIXES_4E §4.3). */
.action--off {
    opacity: 0.58;
    background-color: rgba(48, 54, 74, 0.95);
    border-color: rgba(190, 190, 200, 0.25);
}

.action--off .action-icon {
    -unity-background-image-tint-color: rgb(150, 150, 158);
}

.action--off .action-name {
    color: rgb(190, 190, 198);
}

.action--off:hover {
    translate: 0 0;
    background-color: rgba(48, 54, 74, 0.95);
}

.action--sig {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    max-width: none;
    margin: 0;
    height: 58px;
    padding: 3px 6px 3px 6px;
    border-color: var(--gold);
    background-color: rgba(70, 40, 120, 0.9);
}

.action-key {
    position: absolute;
    left: 2px;
    top: 1px;
    font-size: 9px;
    color: rgb(20, 16, 12);
    background-color: var(--ink-dim);
    border-radius: 3px;
    padding: 0 3px;
    margin: 0;
}

.action-icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.action--sig .action-icon {
    width: 44px;
    height: 44px;
    margin-right: 8px;
}

.action-text {
    align-items: center;
    max-width: 100%;
    flex-shrink: 1;
    min-width: 0;
}

.action--sig .action-text {
    align-items: flex-start;
}

.action-name {
    font-size: 12px;
    margin: 0;
    padding: 0;
    max-width: 100%;
    -unity-text-align: middle-center;
    min-height: 14px;
    white-space: nowrap;
}

.action--sig .action-name {
    font-size: 15px;
}

.action-cost {
    font-size: 10px;
    color: var(--gold);
    min-height: 11px;
    margin: 0;
    padding: 0;
    max-width: 100%;
    white-space: nowrap;
}

/* Narrow screens: smaller text, tighter pieces. */
.hud--compact .round-label { font-size: 22px; }
.hud--compact .score { height: 34px; }
.hud--compact .score-portrait { width: 24px; height: 24px; border-radius: 12px; }
.hud--compact .score-name { font-size: 11px; }
.hud--compact .score-points { font-size: 17px; }
.hud--compact .slot { height: 40px; }
.hud--compact .slot-icon { width: 20px; height: 20px; margin-right: 4px; }
.hud--compact .slot-text { font-size: 11px; }
.hud--compact .slot-num { display: none; }
.hud--compact .slot { padding: 2px 4px; }
.hud--compact .hint { font-size: 10px; }
.hud--compact .grit-box { padding: 2px 6px; }
.hud--compact .grit-num { font-size: 32px; margin-right: 6px; min-width: 22px; }
.hud--compact .grit-pip { width: 11px; height: 11px; border-radius: 6px; margin: 0 1px; }
.hud--compact .action { min-width: 40px; }
.hud--compact .action-name { font-size: 10px; }
.hud--compact .action-cost { font-size: 9px; }
.hud--compact .action--sig .action-icon { width: 32px; height: 32px; margin-right: 5px; }
.hud--compact .action--sig .action-name { font-size: 12px; }
.hud--compact .action-group { margin: 0 3px; padding-left: 5px; }

/* Columns that reach onto the board edge get a firmer backing so they stay readable over the art. */
.hud--overlap .plan-panel,
.hud--overlap .score {
    background-color: rgba(8, 14, 44, 0.9);
}

.tooltip {
    position: absolute;
    max-width: 280px;
    padding: 6px 9px;
    background-color: rgb(8, 12, 34);
    border-color: var(--gold-dark);
    border-width: 1px;
    border-radius: 6px;
    font-size: 12px;
    white-space: normal;
    display: none;
}

/* Announcer banner: Matej's ribbon, text on top. */
.banner {
    position: absolute;
    left: 640px;
    top: 2px;
    width: 300px;
    height: 46px;
    background-image: url("/Assets/_Project/Art/UI/panels/banner.png");
    -unity-slice-left: 200;
    -unity-slice-right: 200;
    -unity-slice-top: 50;
    -unity-slice-bottom: 50;
    -unity-slice-scale: 0.4px;
    align-items: center;
    justify-content: center;
    opacity: 0;
}

.banner-text {
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/PirataOne-Regular.ttf");
    font-size: 28px;
    color: var(--gold);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(30, 16, 4);
    margin: 0 0 3px 0;
    padding: 0;
    white-space: nowrap;
    overflow: hidden;
}

/* ---------- scoreboard and results ---------- */

.score-card {
    width: 600px;
    align-items: stretch;
}

.banner-text--static {
    font-size: 36px;
}

/* Results: the card sits on the right half, over the open floor; the podiums are on the left. */
.results-card {
    position: absolute;
    right: 30px;
    top: 28px;
    bottom: 28px;
    width: 640px;
    align-items: stretch;
    padding: 22px 28px;
}

.results-title {
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/PirataOne-Regular.ttf");
    font-size: 30px;
    color: var(--gold);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(20, 10, 4);
}

.winner-line {
    margin-bottom: 8px;
    font-size: 15px;
    max-width: 560px;
    align-self: center;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.standings {
    flex-grow: 1;
    justify-content: space-around;
    border-top-width: 1px;
    border-color: var(--line);
    padding-top: 6px;
}

.standing {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 4px 0;
}

.standing-place {
    width: 44px;
    font-size: 20px;
    color: var(--ink-dim);
    -unity-font-style: bold;
}

.standing-place--first {
    color: var(--gold);
}

.standing-info {
    width: 150px;
    flex-shrink: 0;
    margin-left: 4px;
}

.standing-name {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 21px;
    -unity-font-style: bold;
}

.standing-points {
    font-size: 16px;
    color: var(--ink-dim);
}

.standing-badges {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-left: 6px;
}

.badge-chip {
    width: 80px;
    align-items: center;
    margin: 1px 2px;
}

.badge-icon {
    width: 42px;
    height: 42px;
    border-radius: 9px;
    overflow: hidden;
}

.badge-art {
    width: 42px;
    height: 42px;
    -unity-background-scale-mode: scale-to-fit;
}

.badge-shine {
    position: absolute;
    top: -12px;
    left: 0;
    width: 12px;
    height: 72px;
    background-color: rgba(255, 255, 255, 0.4);
    rotate: 25deg;
    opacity: 0;
}

.badge-name {
    font-size: 11px;
    color: var(--gold);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 80px;
}

.results-buttons {
    flex-direction: row;
    justify-content: center;
    margin-top: 6px;
}

.results-btn {
    flex-grow: 1;
    flex-basis: 0;
    margin: 4px 8px;
    min-height: 64px;
    font-size: 28px;
}

/* Badge chips open the achievement popup on click. */
.badge-chip:hover {
    scale: 1.08 1.08;
}

.ach {
    position: absolute;
    left: 24px;
    bottom: 24px;
    width: 440px;
    flex-direction: row;
    align-items: center;
    padding: 12px 18px 12px 12px;
    border-radius: 14px;
    border-width: 2px;
    border-color: var(--gold);
    background-color: rgba(10, 18, 56, 0.97);
    opacity: 0;
    display: none;
}

.ach-icon {
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    margin-right: 14px;
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--gold-dark);
    background-color: rgba(255, 206, 96, 0.12);
    align-items: center;
    justify-content: center;
}

.ach-icon > .badge-art {
    width: 62px;
    height: 62px;
}

.ach-text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.ach-kicker {
    font-size: 11px;
    color: var(--ink-faint);
    letter-spacing: 1px;
}

.ach-name {
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/PirataOne-Regular.ttf");
    font-size: 28px;
    color: var(--gold);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(30, 16, 4);
    white-space: nowrap;
}

.ach-desc {
    font-size: 14px;
    color: var(--ink);
    white-space: normal;
}

.ach-who {
    font-size: 12px;
    color: var(--ink-dim);
    margin-top: 3px;
}

.btn--secondary {
    -unity-background-image-tint-color: rgb(185, 195, 225);
    opacity: 0.9;
}

.gains {
    margin-bottom: 10px;
}

.gain {
    flex-direction: row;
    align-items: center;
    padding: 3px 0;
}

.gain-amount {
    width: 44px;
    font-size: 21px;
    color: var(--gold);
}

.gain-text {
    font-size: 15px;
}

.totals {
    border-top-width: 1px;
    border-color: var(--line);
    padding-top: 8px;
}

.total {
    flex-direction: row;
    align-items: center;
    padding: 3px 0;
}

.total-swatch {
    width: 34px;
    height: 34px;
    border-radius: 17px;
    margin-right: 8px;
    border-width: 2px;
    -unity-background-scale-mode: scale-and-crop;
}

.total-name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    max-width: 240px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 16px;
}

.total-wins {
    font-size: 12px;
    color: var(--ink-faint);
    margin-right: 12px;
}

.total-bar {
    width: 150px;
    height: 9px;
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.1);
    margin-right: 10px;
}

.total-fill {
    height: 9px;
    border-radius: 5px;
    background-color: var(--gold);
}

.total-points {
    width: 66px;
    font-size: 18px;
    -unity-text-align: middle-right;
}

.winner {
    max-width: 520px;
    align-self: center;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/PirataOne-Regular.ttf");
    font-size: 50px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(20, 10, 4);
}

.awards {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 8px;
}

.award {
    width: 112px;
    align-items: center;
    margin: 1px 2px;
}

.award-badge {
    width: 44px;
    height: 44px;
    -unity-background-scale-mode: scale-to-fit;
}

.award-name {
    font-size: 12px;
    color: var(--gold);
    -unity-text-align: middle-center;
}

.award-who {
    font-size: 10px;
    color: var(--ink-dim);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---------- world labels (over the board, under the HUD) ---------- */

.world-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.world-label {
    font-size: 13px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.9);
    white-space: nowrap;
}

.unit-name {
    max-width: 130px;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
    font-size: 12px;
}

.stage-name {
    max-width: 220px;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
    font-size: 27px;
    -unity-font-style: bold;
    background-color: rgba(10, 10, 24, 0.5);
    border-radius: 12px;
    padding: 0 12px 1px 12px;
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgba(14, 8, 4, 0.95);
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.8);
}

.stage-status {
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgba(10, 6, 4, 0.95);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
}

.stage-tag {
    font-size: 19px;
    -unity-font-style: bold;
    color: rgb(255, 240, 200);
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgba(14, 8, 4, 0.95);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
}

.keg-fuse {
    font-size: 24px;
    color: rgb(255, 230, 120);
}

.ghost-num {
    font-size: 15px;
    color: rgb(255, 255, 255);
}

.ghost-tag {
    font-size: 11px;
    color: rgb(255, 235, 180);
}

.ghost-dead {
    font-size: 22px;
    color: var(--danger);
}

.popup {
    font-size: 15px;
}

.popup-big {
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/PirataOne-Regular.ttf");
    font-size: 28px;
}

.popup-dmg {
    font-size: 26px;
}

/* ---------- text fields: a clear focus state everywhere (FIXES_4E §1.2) ----------
   The caret is gold and blinks (the engine's cursor flash); the field gets a bright gold border and a lighter fill. */
.unity-base-text-field__input {
    --unity-cursor-color: rgb(255, 214, 120);
    --unity-selection-color: rgba(255, 206, 96, 0.4);
    transition-property: border-color, background-color;
    transition-duration: 0.12s;
}

.unity-base-text-field__input:focus,
.field .unity-base-text-field__input:focus,
.chat-field > .unity-base-text-field__input:focus {
    border-color: rgb(255, 214, 120);
    border-width: 2px;
    background-color: rgba(30, 44, 108, 0.96);
}

.field--error .unity-base-text-field__input:focus {
    border-color: rgb(255, 98, 86);
}

/* Match point: the musketeer's world name label turns gold (FIXES_4E §8.7). */
.unit-name--match {
    color: rgb(255, 224, 120);
    -unity-font-style: bold;
}
