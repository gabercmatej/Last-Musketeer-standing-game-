<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="hud" class="screen" picking-mode="Ignore">
        <!-- Top strip (above the arena): Round/Turn on the left, timer + phase in the centre. -->
        <ui:VisualElement name="top-strip" class="top-strip" picking-mode="Ignore">
            <ui:VisualElement name="top-left" class="top-left" picking-mode="Ignore">
                <ui:Label name="round-label" text="Round 1" class="round-label" />
                <ui:Label name="turn-label" text="Turn 1" class="turn-label" />
            </ui:VisualElement>
            <ui:VisualElement class="top-center" picking-mode="Ignore">
                <ui:Label name="timer" text="25" class="timer" />
                <ui:Label name="phase-label" text="Plan your moves" class="phase-label" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Left column: Fullscreen/Settings/Leave, dev buttons, then the plan panel. -->
        <ui:VisualElement name="left-col" class="side-col left-col" picking-mode="Ignore">
            <ui:VisualElement name="hud-icons" class="hud-icons" picking-mode="Ignore" />
            <ui:VisualElement name="dev-buttons" class="corner-buttons" picking-mode="Ignore">
                <ui:Button name="speed" text="Speed 1x" class="btn btn--small btn--hud" />
                <ui:Button name="log-toggle" text="Log (L)" class="btn btn--small btn--hud" />
            </ui:VisualElement>
            <ui:Label name="dev-badge" text="DEV: CONTROL ALL (F2)  Tab or click a unit to switch" class="badge badge--dev dev-badge" />

            <ui:VisualElement name="plan-panel" class="plan-panel">
                <ui:Label name="planning-for" text="Matej" class="planning-for" />
                <ui:VisualElement name="slots" class="slots" />
                <ui:Label name="hint" text="" class="hint" />
                <ui:Button name="lock" text="Lock in  (Space)" class="btn btn--primary btn--lock" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Right column: the four score boxes, then the chat below them. -->
        <ui:VisualElement name="right-col" class="side-col right-col" picking-mode="Ignore">
            <ui:VisualElement name="scores" class="scores" picking-mode="Ignore" />
            <ui:VisualElement name="chat" class="chat" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="log-panel" class="log-panel">
            <ui:Label text="Turn log" class="log-title" />
            <ui:ScrollView name="log-scroll" class="log-scroll" />
        </ui:VisualElement>

        <!-- Bottom strip (below the arena): big Grit counter, then the grouped action bar. -->
        <ui:VisualElement name="bottom-bar" class="bottom-bar" picking-mode="Ignore">
            <ui:VisualElement name="grit-box" class="grit-box" picking-mode="Ignore">
                <ui:Label text="GRIT" class="grit-title" picking-mode="Ignore" />
                <ui:VisualElement class="grit-row" picking-mode="Ignore">
                    <ui:Label name="grit-num" text="5" class="grit-num" picking-mode="Ignore" />
                    <ui:VisualElement name="grit-pips" class="grit-pips" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="actions" class="actions" />
            <ui:VisualElement name="special-slot" class="special-slot" />
        </ui:VisualElement>

        <ui:Label name="tooltip" text="" class="tooltip" picking-mode="Ignore" />
        <ui:VisualElement name="banner" class="banner" picking-mode="Ignore">
            <ui:Label name="banner-text" text="" class="banner-text" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
