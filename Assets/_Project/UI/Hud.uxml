<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="hud" class="screen" picking-mode="Ignore">
        <ui:VisualElement name="top-bar" class="top-bar">
            <ui:VisualElement class="top-left" picking-mode="Ignore">
                <ui:Label name="round-label" text="Round 1" class="round-label" />
                <ui:Label name="turn-label" text="Turn 1" class="turn-label" />
            </ui:VisualElement>
            <ui:VisualElement class="top-center" picking-mode="Ignore">
                <ui:Label name="timer" text="25" class="timer" />
                <ui:Label name="phase-label" text="Plan your moves" class="phase-label" />
            </ui:VisualElement>
            <ui:VisualElement name="scores" class="scores" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement class="corner-buttons">
            <ui:Button name="speed" text="Speed 1x" class="btn btn--small" />
            <ui:Button name="log-toggle" text="Log (L)" class="btn btn--small" />
            <ui:Button name="quit" text="Menu" class="btn btn--small" />
        </ui:VisualElement>
        <ui:Label name="dev-badge" text="DEV: CONTROL ALL (F2)  Tab or click a unit to switch" class="badge badge--dev dev-badge" />

        <ui:VisualElement name="log-panel" class="log-panel">
            <ui:Label text="Turn log" class="log-title" />
            <ui:ScrollView name="log-scroll" class="log-scroll" />
        </ui:VisualElement>

        <ui:VisualElement name="plan-bar" class="plan-bar">
            <ui:VisualElement class="plan-row">
                <ui:Label name="planning-for" text="Matej" class="planning-for" />
                <ui:VisualElement name="slots" class="slots" />
                <ui:Button name="lock" text="Lock in  (Space)" class="btn btn--primary btn--lock" />
            </ui:VisualElement>
            <ui:Label name="hint" text="" class="hint" />
            <ui:VisualElement name="actions" class="actions" />
        </ui:VisualElement>

        <ui:Label name="tooltip" text="" class="tooltip" picking-mode="Ignore" />
        <ui:Label name="banner" text="" class="banner" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
